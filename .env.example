# --- LoreForge local config (copy to .env) ---

# Port the API listens on
PORT=3000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/loreforge

# Optional API key. Leave empty for open access on your own network;
# set it to require clients to send it as the x-api-key header.
API_KEY=

# Admin key for /api/v1/admin/* (ingest jobs cost real LLM money, keep this
# private). The admin UI sends it as the x-api-key header. Leave empty only
# if the admin API should stay open.
ADMIN_KEY=

# Demo mode for public exposure (e.g. via Tailscale funnel). Default true:
# traffic arriving through the local funnel proxy gets a tight shared rate
# limit (30/min), reduced page sizes, and read-only access to existing
# sources (adding sources always needs ADMIN_KEY). LAN traffic and requests
# with a valid ADMIN_KEY are never restricted. Set to false to remove all
# demo limits (for your own non-demo installs).
DEMO_MODE=true
DEMO_RATE_LIMIT_PER_MINUTE=30

# Required for ingestion and trivia generation (https://platform.deepseek.com)
# You can also use local Ollama instead — see config/llm.json
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Max characters of page text sent to the LLM per extraction call
MAX_TEXT_CHARS=12000

# In-memory rate limit, requests per minute per key (or per IP when open)
RATE_LIMIT_PER_MINUTE=100
